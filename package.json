{
  "name": "@AnNingUI/dsh-client-ui-skin-md3-wallpaper",
  "version": "0.1.0",
  "description": "Standalone Material You (MD3) dynamic-color skin for the dsh web GUI: upload any wallpaper, Monet extracts the palette with @material/material-color-utilities, and every UI token, SVG and surface follows",
  "license": "Apache-2.0",
  "files": [
    "lib",
    "cordis.patch.yml",
    "skin.json",
    "preview",
    "README.md"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "install:dsh": "node scripts/install.mjs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^26.2.0",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "oxfmt": "^0.63.0",
    "tsdown": "^0.22.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}
